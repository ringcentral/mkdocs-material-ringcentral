{% extends "_rc_base.html" %}
{#
  Default shim — used by sites that have no custom_dir/main.html of their own.
  All RC branding (announce banners, footer) lives in _rc_base.html.

  Sites that need to override the announce block or any other block should
  create docs/overrides/main.html (or whichever path is set as custom_dir)
  with the following as their starting point:

    {% extends "_rc_base.html" %}

    {% block announce %}
      Your site-wide banner text — <a href="/path/">link</a>
    {% endblock %}
#}
